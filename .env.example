# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=norm
POSTGRES_PASSWORD=norm
POSTGRES_DB=norm

# MySQL (runtime e2e uses MYSQL_*; admin user needs CREATE DATABASE)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=norm
MYSQL_DATABASE=norm
MYSQL_USER=root
MYSQL_PASSWORD=norm

# ClickHouse
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=norm
CLICKHOUSE_DATABASE=default

# App
DB_POOL_SIZE=20
